# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=  # openssl rand -base64 32

# GitHub OAuth — https://github.com/settings/developers
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_ID=
GOOGLE_SECRET=

# Database (Neon Postgres via Vercel integration)
DATABASE_URL=
DIRECT_DATABASE_URL=

# Public 306.5M inference Spaces
NEXT_PUBLIC_TR_MOE_API_URL=https://pacific-i64-tr-moe-306.hf.space
NEXT_PUBLIC_COMPARE_API_URL=https://pacific-i64-compare-306.hf.space
NEXT_PUBLIC_DENSE_API_URL=https://pacific-i64-dense-306.hf.space

# Optional public messages; a non-empty value disables that mode.
NEXT_PUBLIC_TR_MOE_MAINTENANCE=
NEXT_PUBLIC_COMPARE_MAINTENANCE=
NEXT_PUBLIC_DENSE_MAINTENANCE=
